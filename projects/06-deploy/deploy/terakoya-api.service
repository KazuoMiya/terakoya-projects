# 課題6: systemd ユニットファイル（穴埋めテンプレート）
# Project 6: systemd unit file (fill-in-the-blank template)
#
# <あなたのユーザー名> を自分のものに置き換えてから、次の場所に置く:
# Replace <あなたのユーザー名> (= your username) with your own, then install it:
#   sudo cp deploy/terakoya-api.service /etc/systemd/system/terakoya-api.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now terakoya-api
#
# ポイントは3つ。
#   1. パスは全部「絶対パス」。systemd の世界にはあなたの venv も cd も無い
#      （課題3の cron で踏んだ罠と同じだ）。
#   2. --host 127.0.0.1 でローカルにだけ待ち受ける。外への窓口は Nginx に任せる。
#   3. 秘密（API_KEY）は EnvironmentFile で .env から読む。ここに直書きしない。
#      注意: .env に「行内コメント」を書かないこと（API_KEY=x  # メモ、のような形）。
#      python-dotenv は # 以降を剥がすが、systemd は値の一部として読む——
#      開発では動くのに systemd 経由でだけ認証が壊れる、という嫌な差になる。
# Three points.
#   1. Every path is an absolute path. In systemd's world there is no venv
#      and no cd of yours (the same trap you hit with cron in Project 3).
#   2. --host 127.0.0.1 listens on localhost only. Nginx handles the
#      outside-facing door.
#   3. The secret (API_KEY) is read from .env via EnvironmentFile — never
#      hard-coded here. Caution: no inline comments in .env (forms like
#      API_KEY=x  # memo). python-dotenv strips everything after #, but
#      systemd reads it as part of the value — the nasty kind of difference
#      where dev works but auth breaks only under systemd.
#
# ★パスについて: このテンプレは「ホームに terakoya-projects という名前で clone した」
#   前提で書いてある。名前が違う場合は、下のパス3か所をすべて実際のパスに直すこと
#  （ls で実在を確かめてから）。パス間違いは 203/EXEC エラーの一番の原因だ。
# ★About paths: this template assumes you cloned into your home directory
#   under the name terakoya-projects. If your name differs, fix all three
#   paths below to the real ones (verify they exist with ls first).
#   Wrong paths are the number-one cause of 203/EXEC errors.

[Unit]
Description=Terakoya 点検結果管理API（課題5で作ったもの）
# ネットワークが用意できてから起動する
# Start only after the network is ready
After=network.target

[Service]
# root で動かさない。普段使いのユーザーで十分だ（最小権限）
# Do not run as root. Your everyday user is enough (least privilege)
User=<あなたのユーザー名>
WorkingDirectory=/home/<あなたのユーザー名>/terakoya-projects/projects/05-web-api
# 秘密は .env から（このファイルに直書きしない）
# Secrets come from .env (never hard-coded in this file)
EnvironmentFile=/home/<あなたのユーザー名>/terakoya-projects/projects/05-web-api/.env
# venv の中の uvicorn を「絶対パス」で指す。--reload は本番では使わない
# Point at the uvicorn inside the venv by absolute path. Never use --reload in production
ExecStart=/home/<あなたのユーザー名>/terakoya-projects/.venv/bin/uvicorn app:app --app-dir src --host 127.0.0.1 --port 8000
# 落ちたら自動で再起動する（常駐の要）
# Restart automatically on failure (the heart of running as a daemon)
Restart=on-failure
RestartSec=3

[Install]
# 「サーバー起動時に自動で立ち上がる」の合図。enable で有効になる
# The "start automatically at boot" signal. Takes effect via enable
WantedBy=multi-user.target
