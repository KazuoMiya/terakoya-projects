# このファイルを .env にコピーして使う（cp .env.example .env）。
#
#   .env は .gitignore に入っているので、コミットされない。
#   これが「秘密の分離」の一番小さな実物だ。パスワードをコードにも
#   compose.yml にも書かず、環境ごとに差し替えられる場所へ追い出す。
#
# ここに書くのは検証環境のパスワードだけ。本物の値は絶対に書かない。

# PostgreSQL の管理ユーザー（postgres）のパスワード
POSTGRES_PASSWORD=devpassword

# 点検専用・読み取り専用ユーザー（checker）のパスワード
CHECKER_PASSWORD=checkerpass

# 点検ツールが使う接続情報。読み取り専用の checker で入る（管理ユーザーでは入らない）。
# 注意: CHECKER_PASSWORD を変えたら、下の DB_DSN の中のパスワードも同じ値に直すこと
#（2か所に書いてある。片方だけ変えると繋がらなくなる）。
DB_DSN=postgresql://checker:checkerpass@localhost:5432/terakoya

# Oracle選択トラックの人だけ
ORACLE_PASSWORD=oraclepass
ORACLE_DSN=checker/checkerpass@localhost:1521/FREEPDB1
